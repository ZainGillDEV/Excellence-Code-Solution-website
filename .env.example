# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in what you need.
# Everything here is OPTIONAL — the site runs without any of it.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata / Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# Leave MONGODB_URI empty and contact submissions are written to
# data/contacts.json instead. Set it to use MongoDB (Atlas or local).
MONGODB_URI=
MONGODB_DB=ecs

# --- Email (SMTP) ----------------------------------------------------------
# Without these the enquiry is still saved — no email is sent.
# Gmail example: host smtp.gmail.com, port 587, and an App Password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=

# --- Admin -----------------------------------------------------------------
# Bearer token for GET /api/contact (listing enquiries).
# Generate one with:  openssl rand -hex 32
ADMIN_API_TOKEN=

# ---------------------------------------------------------------------------
# Copy this file to .env.local and fill in what you need.
# On Netlify/Vercel, add the same keys under the site's Environment variables.
# ---------------------------------------------------------------------------

# Public site URL (used for metadata, Open Graph, sitemap and llms.txt)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database --------------------------------------------------------------
# REQUIRED IN PRODUCTION. Without it, enquiries are written to
# data/contacts.json, which does not work on serverless hosts such as
# Netlify or Vercel (their filesystem is read-only).
MONGODB_URI=
MONGODB_DB=ecs

# --- Admin dashboard (/admin) ----------------------------------------------
# ADMIN_PASSWORD        what you type on the /admin sign-in screen
# ADMIN_SESSION_SECRET  signs the session cookie — any long random string
# ADMIN_API_TOKEN       optional bearer token for GET /api/contact
#
# Generate the secret and token with:  openssl rand -hex 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=
ADMIN_API_TOKEN=

# --- Email (SMTP) ----------------------------------------------------------
# Without these the enquiry is still saved — no email is sent.
# Gmail: host smtp.gmail.com, port 587, and an App Password (not your
# normal password).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
MAIL_TO=
